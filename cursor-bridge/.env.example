# Required: Cursor API key (from https://cursor.com/dashboard/api)
# Format: crsr_... (both User API keys and Service Account keys work)
# Prefer setting this in RegX Settings → API Keys (per-user); bridge default is optional.
CURSOR_API_KEY=crsr_...

# Bridge server port (default 5002)
CURSOR_BRIDGE_PORT=5002

# Corporate SSL inspection: npm start uses start.sh which exports NODE_EXTRA_CA_CERTS
# (macOS system+login keychain). Required for @cursor/sdk to reach api.cursor.com.

# Cursor model for deep triage (default claude-sonnet-4-6)
CURSOR_MODEL_ID=claude-sonnet-4-6

# Faster model for Ask-mode follow-up chat (default composer-2)
CURSOR_FOLLOWUP_MODEL_ID=composer-2

# MCP profile: triage (lean, default) | full | none
CURSOR_MCP_PROFILE=triage

# RegX MCP server URL (default http://localhost:5003)
REGX_MCP_URL=http://localhost:5003

# Atlassian tokens for Jira/Confluence MCP access (optional)
ATLASSIAN_JIRA_TOKEN=
ATLASSIAN_CONFLUENCE_TOKEN=
