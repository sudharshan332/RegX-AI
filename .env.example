# RegX-AI backend environment variables.
# Copy this file to ".env" (same directory) and fill in real values.
# The .env file is gitignored — never commit real tokens.

# Jira personal access token for jira.nutanix.com (Bearer auth).
# Required to populate ticket Status, Issue Type and Bug Type on the Home dashboard.
JIRA_TOKEN=

# Glean API token (optional — used for similar-issue search / AI triage context).
GLEAN_TOKEN=

# Members of the cdp_reg_jarvis regression group (comma-separated sAMAccountNames).
# Any member may create/delete ANY RegX-managed Job Profile / Test Set (entities the
# tool tags with user_groups=["cdp_reg_jarvis"]), regardless of individual ownership.
# Leave blank to use the built-in default team roster.
CDP_REG_JARVIS_MEMBERS=

# Optional: usernames allowed to delete ANY JP/TS, incl. those NOT managed by RegX
# (comma-separated sAMAccountNames). Broader than the group above; use sparingly.
JP_DELETE_ADMIN_USERS=
